# Discord Bot Token (From https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Channel ID where automated signals/alerts should be sent (leave empty or set channel ID)
ALERT_CHANNEL_ID=

# Automated Scanner Settings
AUTO_SCAN_ENABLED=true
AUTO_SCAN_INTERVAL_MINUTES=5
MIN_SIGNAL_CONFIDENCE=75

# Default Watchlist (comma-separated MEXC trading pairs)
DEFAULT_WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT,PEPE/USDT,SUI/USDT,BNB/USDT
